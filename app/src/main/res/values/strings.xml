    <!-- ===================================================== Failover screen -->

    <string name="mobile_nodes_title">Servers for\nmobile data</string>
    <string name="mobile_nodes_off">Off: one list for every network</string>
    <string name="mobile_nodes_explanation">When the phone moves to a cellular network the tunnel moves onto a server from this list and stays within it: a replacement for a failure is taken from here too. While the list is empty nothing changes and every network shares one list. What counts is the cellular network itself, not a metered one — a temporarily unmetered 5G plan and a home Wi-Fi marked as limited both stay out of it. Put two or three servers here at least; from one there is nowhere to go.</string>
    <string name="mobile_nodes_clear">Clear and stop separating networks</string>

    <string name="settings_mobile_nodes">Servers for mobile data</string>
    <string name="settings_mobile_nodes_off">Not separated: one list everywhere</string>
    <string name="settings_mobile_nodes_chosen">Chosen: %1$d</string>
    <string name="settings_restore_wifi">Restore the previous server</string>
    <string name="settings_restore_wifi_subtitle">Coming back to Wi-Fi puts the tunnel on the server it left, instead of choosing again</string>
    <string name="failover_title">Server\nfailover</string>
    <string name="failover_automatic">Chosen automatically</string>
    <string name="failover_chosen">%1$s chosen</string>
    <string name="failover_explanation">While the tunnel is up, the app probes the current server every 20 seconds. If it fails to answer twice in a row, the servers chosen here are measured afresh: the ones that do not answer drop out, so do the ones that are slow next to the rest, and one of the survivors is picked at random. At random rather than fastest, so that a popular server going down does not send everybody to the same replacement. At most %1$d servers take part, the current one included.</string>
    <string name="failover_clear_selection">Clear the selection and decide automatically</string>
    <string name="failover_no_servers">Add some servers first — there is nothing to fail over to</string>

